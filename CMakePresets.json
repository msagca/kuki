{
  "version": 9,
  "cmakeMinimumRequired": { "major": 3, "minor": 31, "patch": 0 },
  "configurePresets": [
    {
      "name": "Base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": { "CMAKE_EXPORT_COMPILE_COMMANDS": "ON" }
    },
    {
      "name": "Debug",
      "inherits": "Base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "Release",
      "inherits": "Base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "KUKI_BUILD_GAMES": "ON",
        "KUKI_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "MSVC",
      "inherits": "Base",
      "generator": "Visual Studio 18 2026",
      "cacheVariables": { "CMAKE_C_COMPILER": "cl", "CMAKE_CXX_COMPILER": "cl" }
    },
    {
      "name": "Clang",
      "hidden": true,
      "inherits": "Base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "Clang-Debug",
      "inherits": "Clang",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "Clang-Release",
      "inherits": "Clang",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    }
  ],
  "buildPresets": [
    { "name": "Debug", "configurePreset": "Debug", "configuration": "Debug" },
    {
      "name": "Release",
      "configurePreset": "Release",
      "configuration": "Release"
    },
    {
      "name": "MSVC-Debug",
      "configurePreset": "MSVC",
      "configuration": "Debug"
    },
    {
      "name": "MSVC-Release",
      "configurePreset": "MSVC",
      "configuration": "Release"
    },
    { "name": "Clang-Debug", "configurePreset": "Clang-Debug" },
    { "name": "Clang-Release", "configurePreset": "Clang-Release" }
  ],
  "testPresets": [
    { "name": "Debug", "configurePreset": "Debug" },
    { "name": "Release", "configurePreset": "Release" },
    { "name": "MSVC-Debug", "configurePreset": "MSVC" },
    { "name": "MSVC-Release", "configurePreset": "MSVC" },
    { "name": "Clang-Debug", "configurePreset": "Clang-Debug" },
    { "name": "Clang-Release", "configurePreset": "Clang-Release" }
  ],
  "packagePresets": [
    { "name": "Release", "configurePreset": "Release" },
    { "name": "MSVC-Release", "configurePreset": "MSVC" },
    { "name": "Clang-Release", "configurePreset": "Clang-Release" }
  ],
  "workflowPresets": [
    {
      "name": "Debug",
      "steps": [
        { "type": "configure", "name": "Debug" },
        { "type": "build", "name": "Debug" },
        { "type": "test", "name": "Debug" }
      ]
    },
    {
      "name": "Release",
      "steps": [
        { "type": "configure", "name": "Release" },
        { "type": "build", "name": "Release" },
        { "type": "test", "name": "Release" },
        { "type": "package", "name": "Release" }
      ]
    },
    {
      "name": "MSVC-Debug",
      "steps": [
        { "type": "configure", "name": "MSVC" },
        { "type": "build", "name": "MSVC-Debug" },
        { "type": "test", "name": "MSVC-Debug" }
      ]
    },
    {
      "name": "MSVC-Release",
      "steps": [
        { "type": "configure", "name": "MSVC" },
        { "type": "build", "name": "MSVC-Release" },
        { "type": "test", "name": "MSVC-Release" },
        { "type": "package", "name": "MSVC-Release" }
      ]
    },
    {
      "name": "Clang-Debug",
      "steps": [
        { "type": "configure", "name": "Clang-Debug" },
        { "type": "build", "name": "Clang-Debug" },
        { "type": "test", "name": "Clang-Debug" }
      ]
    },
    {
      "name": "Clang-Release",
      "steps": [
        { "type": "configure", "name": "Clang-Release" },
        { "type": "build", "name": "Clang-Release" },
        { "type": "test", "name": "Clang-Release" },
        { "type": "package", "name": "Clang-Release" }
      ]
    }
  ]
}
