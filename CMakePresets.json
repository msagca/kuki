{
  "version": 9,
  "cmakeMinimumRequired": { "major": 3, "minor": 31, "patch": 0 },
  "configurePresets": [
    {
      "name": "Base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "BUILD_SHARED_LIBS": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "KUKI_BUILD_GAMES": "ON",
        "KUKI_BUILD_TESTS": "OFF",
        "KUKI_ENABLE_LINTING": "OFF"
      }
    },
    {
      "name": "WithTests",
      "hidden": true,
      "cacheVariables": { "KUKI_BUILD_TESTS": "ON" }
    },
    {
      "name": "WithLinting",
      "hidden": true,
      "cacheVariables": { "KUKI_ENABLE_LINTING": "ON" }
    },
    {
      "name": "Debug",
      "inherits": "Base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "Release",
      "inherits": "Base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "Test",
      "inherits": ["WithTests", "Debug"]
    },
    {
      "name": "Lint",
      "inherits": ["WithLinting", "WithTests", "Debug"]
    },
    {
      "name": "Package",
      "inherits": ["WithTests", "Release"]
    },
    {
      "name": "MSVC",
      "inherits": "Base",
      "generator": "Visual Studio 18 2026",
      "cacheVariables": { "CMAKE_C_COMPILER": "cl", "CMAKE_CXX_COMPILER": "cl" }
    },
    {
      "name": "Clang",
      "hidden": true,
      "inherits": "Base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "Clang-Debug",
      "inherits": "Clang",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "Clang-Release",
      "inherits": "Clang",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    }
  ],
  "buildPresets": [
    { "name": "Debug", "configurePreset": "Debug", "configuration": "Debug" },
    {
      "name": "Release",
      "configurePreset": "Release",
      "configuration": "Release"
    },
    { "name": "Test", "configurePreset": "Test", "configuration": "Debug" },
    { "name": "Lint", "configurePreset": "Lint", "configuration": "Debug" },
    {
      "name": "Package",
      "configurePreset": "Package",
      "configuration": "Release"
    },
    {
      "name": "MSVC-Debug",
      "configurePreset": "MSVC",
      "configuration": "Debug"
    },
    {
      "name": "MSVC-Release",
      "configurePreset": "MSVC",
      "configuration": "Release"
    },
    { "name": "Clang-Debug", "configurePreset": "Clang-Debug" },
    { "name": "Clang-Release", "configurePreset": "Clang-Release" }
  ],
  "testPresets": [
    {
      "name": "Test",
      "configurePreset": "Test",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "Package",
      "configurePreset": "Package",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    }
  ],
  "packagePresets": [
    {
      "name": "Package",
      "configurePreset": "Package",
      "configurations": ["Release"]
    }
  ],
  "workflowPresets": [
    {
      "name": "Debug",
      "steps": [
        { "type": "configure", "name": "Debug" },
        { "type": "build", "name": "Debug" }
      ]
    },
    {
      "name": "Release",
      "steps": [
        { "type": "configure", "name": "Release" },
        { "type": "build", "name": "Release" }
      ]
    },
    {
      "name": "Test",
      "steps": [
        { "type": "configure", "name": "Test" },
        { "type": "build", "name": "Test" },
        { "type": "test", "name": "Test" }
      ]
    },
    {
      "name": "Lint",
      "steps": [
        { "type": "configure", "name": "Lint" },
        { "type": "build", "name": "Lint" }
      ]
    },
    {
      "name": "Package",
      "steps": [
        { "type": "configure", "name": "Package" },
        { "type": "build", "name": "Package" },
        { "type": "test", "name": "Package" },
        { "type": "package", "name": "Package" }
      ]
    },
    {
      "name": "MSVC-Debug",
      "steps": [
        { "type": "configure", "name": "MSVC" },
        { "type": "build", "name": "MSVC-Debug" }
      ]
    },
    {
      "name": "MSVC-Release",
      "steps": [
        { "type": "configure", "name": "MSVC" },
        { "type": "build", "name": "MSVC-Release" }
      ]
    },
    {
      "name": "Clang-Debug",
      "steps": [
        { "type": "configure", "name": "Clang-Debug" },
        { "type": "build", "name": "Clang-Debug" }
      ]
    },
    {
      "name": "Clang-Release",
      "steps": [
        { "type": "configure", "name": "Clang-Release" },
        { "type": "build", "name": "Clang-Release" }
      ]
    }
  ]
}
